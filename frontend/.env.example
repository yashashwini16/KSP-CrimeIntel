# ─────────────────────────────────────────────────────────────
# KSP CrimeIntel — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit the .env.local file to version control.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# ── Backend API ───────────────────────────────────────────────
# Base URL of the backend AppSail deployment (no trailing slash).
# Used by lib/api.ts for all authenticated API calls.
NEXT_PUBLIC_API_URL=https://backend-<project>.catalystappsail.com

# ── Catalyst Zia Services — Speech-to-Text ───────────────────
# Browser-facing endpoint for Catalyst Zia speech-to-text.
# The VoiceButton component posts audio blobs to this URL.
NEXT_PUBLIC_ZIA_STT_ENDPOINT=https://zia.catalyst.zoho.com/v1/projects/<project_id>/stt

# ── Catalyst Signals ─────────────────────────────────────────
# Signals event stream URL subscribed to by useRealtime hook
# for real-time alert notifications.
NEXT_PUBLIC_SIGNALS_ENDPOINT=https://signals.catalyst.zoho.com/v1/projects/<project_id>/subscribe
